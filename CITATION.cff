doi: 10.5281/zenodo.24142926
repository-code: "https://github.com/jorgebmann/hanner-hydra"
license: BSD-3-Clause
keywords:
  - time series classification
  - random convolutional kernels
  - Hydra
  - Hanner polytopes
  - ternary kernels
  - multiplication-free
  - aeon
